# ── ZebPay Futures credentials ───────────────────────────────────────────────
# Create keys in the "API Trading" section of https://api.zebpay.com
#
#   fetch:details   -> private reads (balance, orders, positions) + private WebSocket
#   futures:trading -> all REST write operations (place / edit / cancel / margin / close)
#
# A key intended for full REST trading *and* private WebSocket events needs BOTH scopes.
# The secret is used locally to produce HMAC-SHA256 signatures and is never transmitted.
ZEBPAY_API_KEY=
ZEBPAY_API_SECRET=

# Optional: operate on a subaccount. Sent as the `subaccountid` header on REST
# and included in the signed WebSocket handshake payload.
ZEBPAY_SUBACCOUNT_ID=

# ── Live trading kill switch ────────────────────────────────────────────────
# The strategy engine runs in DRY-RUN mode unless BOTH of these are true:
#   1. ZEBPAY_ALLOW_LIVE=true in the environment
#   2. the `--live` flag is passed on the command line
# Leave this unset (or "false") to guarantee no real order is ever transmitted.
ZEBPAY_ALLOW_LIVE=false

# ── Transport ───────────────────────────────────────────────────────────────
ZEBPAY_FUTURES_BASE_URL=https://futuresbe.zebpay.com
ZEBPAY_FUTURES_WS_URL=https://sp-futuresws.zebpay.com
ZEBPAY_REQUEST_TIMEOUT_MS=10000
ZEBPAY_MAX_RETRIES=4

# ── Dashboard ───────────────────────────────────────────────────────────────
PORT=4173
ZEBPAY_DASHBOARD_SYMBOL=BTCINR
