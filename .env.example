# Trading is paper-only unless ALL live gates are explicitly configured.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ZEBPAY_API_KEY=
ZEBPAY_SECRET_KEY=
APP_PASSWORD=
ADMIN_PASSWORD=
JWT_SECRET=
SECURE_COOKIE=false
AUTO_LIVE_TRADING_ENABLED=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Spot-only, INR quote pairs by default. These symbols are also the hard trade allowlist.
ALLOWED_SYMBOLS=BTC/INR,ETH/INR

# Guardrails. Values are in the quote asset (INR with the default allowlist).
MAX_ORDER_NOTIONAL=25000
MAX_DAILY_NOTIONAL=100000
MAX_OPEN_ORDERS=8
MIN_ORDER_NOTIONAL=100
MAX_PRICE_DEVIATION_PCT=0.01
MAX_POSITION_BASE=0.001
MAX_DAILY_LOSS_QUOTE=5000
MAX_DAILY_TRADES=50
COOLDOWN_AFTER_LOSS_SEC=300
CIRCUIT_BREAKER_PCT=0.05

# Paper account and local SQLite database.
PAPER_STARTING_INR=500000
DATABASE_PATH=data/zepay.sqlite3
# Optional: defaults to private_settings.json beside DATABASE_PATH.
# PRIVATE_SETTINGS_PATH=data/private_settings.json

# Kronos is optional and is never allowed to submit orders.
KRONOS_ENABLED=false
KRONOS_PATH=models/Kronos
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cpu
KRONOS_LOOKBACK=128
KRONOS_PRED_LEN=3
