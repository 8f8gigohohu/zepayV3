# DarkDevil Quant environment template. Copy to .env and fill in.
# NEVER put real secrets in this file or in source control.

# --- Core ---------------------------------------------------------------
DJQ_ENVIRONMENT=development            # production requires DJQ_SECRET_KEY
DJQ_DATABASE_URL=sqlite+aiosqlite:///./data/darkdevil.db
# production example (docker-compose): DJQ_DATABASE_URL=postgresql+asyncpg://djq:CHANGE_ME@db:5432/darkdevil

# --- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJQ_SECRET_KEY=CHANGE_ME_GENERATE_OWN
DJQ_ACCESS_TOKEN_EXP_MINUTES=720

# --- Exchange endpoints (M1 verified defaults; see ARCHITECTURE.md) ------
# api.binance.com is geo-restricted from some networks (HTTP 451). The default
# below is Binance's OFFICIAL market-data-only host for public data.
DJQ_BINANCE_REST_PUBLIC_URL=https://data-api.binance.vision
DJQ_BINANCE_REST_PRIVATE_URL=https://api.binance.com
DJQ_BINANCE_WS_MARKET_URL=wss://data-stream.binance.vision
DJQ_ZEBPAY_REST_URL=https://sapi.zebpay.com

# --- Risk (conservative defaults; explain before loosening) ---------------
DJQ_LIVE_TRADING_ENABLED=false        # hard-disabled in M1 regardless
DJQ_MAX_ORDER_NOTIONAL_QUOTE=1000
DJQ_MAX_DAILY_REALIZED_LOSS_QUOTE=200
DJQ_MAX_OPEN_POSITION_NOTIONAL_QUOTE=1000

# --- Misc ----------------------------------------------------------------
DJQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
